APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=org_events_scheduling_system
DB_USERNAME=root
DB_PASSWORD=
# Aiven MySQL TLS (optional): path written by docker/start.sh from AIVEN_CA_CERT / AIVEN_CA_B64
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/aiven-ca.pem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Security Settings (IMPORTANT: Enable these in production!)
# SESSION_ENCRYPT=true          # Encrypt session data
# SESSION_SECURE_COOKIE=true    # Only send cookies over HTTPS
# SESSION_HTTP_ONLY=true        # Prevent JavaScript access to cookies (default: true)
# SESSION_SAME_SITE=lax         # CSRF protection (options: lax, strict, none)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis / Valkey (local) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Production on Render + Aiven Valkey (recommended) ---
# Pick a Valkey region matching your Render web service region.
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT
# REDIS_SSL=true
# REDIS_SSL_CA=/etc/ssl/certs/aiven-ca.pem
# AIVEN_CA_CERT=   # PEM contents, or use AIVEN_CA_B64 on Render
# CLEAR_APP_CACHE_ON_DEPLOY=false
# QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=noreply@plv.edu.ph
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
